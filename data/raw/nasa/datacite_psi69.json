{"data":{"id":"10.60555/mbq8-0451","type":"dois","attributes":{"doi":"10.60555/mbq8-0451","prefix":"10.60555","suffix":"mbq8-0451","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Shaw, Benjamin D","nameType":"Personal","givenName":"Benjamin D","familyName":"Shaw","affiliation":[],"nameIdentifiers":[]},{"name":"Hicks, Michael C","nameType":"Personal","givenName":"Michael C","familyName":"Hicks","affiliation":[],"nameIdentifiers":[]},{"name":"Williams, Forman A","nameType":"Personal","givenName":"Forman A","familyName":"Williams","affiliation":[],"nameIdentifiers":[]},{"name":"Nayagam, Vedha","nameType":"Personal","givenName":"Vedha","familyName":"Nayagam","affiliation":[],"nameIdentifiers":[]},{"name":"Choi, Mun Y","nameType":"Personal","givenName":"Mun Y","familyName":"Choi","affiliation":[],"nameIdentifiers":[]},{"name":"Dryer, Frederick L","nameType":"Personal","givenName":"Frederick L","familyName":"Dryer","affiliation":[],"nameIdentifiers":[]},{"name":"Dietrich, Daniel","nameType":"Personal","givenName":"Daniel","familyName":"Dietrich","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flame Extinguishment Experiment"},{"title":"FLEX","titleType":"Subtitle"}],"publisher":"NASA PSI","container":{},"publicationYear":2016,"subjects":[{"subject":"Microgravity Investigation"},{"subject":"National Aeronautics and Space Administration (NASA)"}],"contributors":[],"dates":[{"date":"31-Jul-2016","dateType":"Available"},{"date":"31-Jul-2016","dateType":"Submitted"}],"language":null,"types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"Creative Commons Zero v1.0 Universal","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc0-1.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The FLEX (Flame Extinguishment Experiment) investigation aims to map the flammability limits of liquid fuels in microgravity environments, measure the effectiveness of various gaseous fire suppressants such as CO2, He, and SF6, and develop reliable predictive models for combustion limits under reduced gravity conditions. The mission seeks to validate and improve simplified models by incorporating detailed chemical reactions, heat transfer, and material movement, using both space-based data and extensive ground-based tests. Key flight experiment goals include obtaining high-resolution measurements of droplet burning rates, flame extinction behavior, heat radiation, soot levels, and temperature profiles, while systematically analyzing the effects of different ambient conditions and suppressant concentrations. These investigations are essential for advancing the fundamental understanding of combustion processes in microgravity and enhancing fire safety protocols for future space missions.","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[{"funderName":"NNX09AM33A"}],"xml":"","url":"https://psi.nasa.gov/physci/repo/data/investigations/PSI-69","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2024-09-18T23:43:24.000Z","registered":"2024-09-19T03:08:41.000Z","published":"2016","updated":"2025-06-06T20:24:23.000Z"},"relationships":{"client":{"data":{"id":"nasasmd.psi","type":"clients"}},"provider":{"data":{"id":"nasasmd","type":"providers"}},"media":{"data":{"id":"10.60555/mbq8-0451","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"da